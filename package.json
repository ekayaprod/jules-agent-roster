{
  "name": "fusion-lab",
  "version": "1.0.0",
  "description": "Fusion Lab Project",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "benchmark": "node benchmark.js",
    "build:roster": "node scripts/build-roster.js",
    "start": "npm run build:roster && npx http-server -p 8080",
    "test": "npm run build:roster && node benchmark.js",
    "test:unit": "npm run build:roster && jest --testPathIgnorePatterns=\"playwright/\"",
    "test:e2e": "npx playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "30.1.1",
    "playwright": "^1.63.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/playwright/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!@exodus/bytes)"
    ]
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "zod": "^4.6.5"
  }
}
